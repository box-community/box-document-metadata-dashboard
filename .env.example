# Copy this file to .env and fill in your real values.
# Find credentials in the Box Developer Console:
# https://cloud.app.box.com/developers/console

# Developer token from Configuration > App Details > Access.
# Expires 60 minutes after you generate it.
BOX_DEVELOPER_TOKEN=your_developer_token

# Folder ID of the folder that holds your invoices
# (from the URL: https://app.box.com/folder/123456789 -> 123456789)
BOX_FOLDER_ID=your_folder_id
